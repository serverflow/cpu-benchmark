set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR k1om)

if(DEFINED ENV{SFBENCH_K1OM_CC})
    set(CMAKE_C_COMPILER "$ENV{SFBENCH_K1OM_CC}")
else()
    set(CMAKE_C_COMPILER k1om-mpss-linux-gcc)
endif()

if(DEFINED ENV{SFBENCH_K1OM_CXX})
    set(CMAKE_CXX_COMPILER "$ENV{SFBENCH_K1OM_CXX}")
else()
    set(CMAKE_CXX_COMPILER k1om-mpss-linux-g++)
endif()

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(DEFINED ENV{SFBENCH_MPSS_ROOT})
    set(_SFBENCH_MPSS_ROOT "$ENV{SFBENCH_MPSS_ROOT}")
else()
    set(_SFBENCH_MPSS_ROOT "/opt/mpss/3.8.6")
endif()

set(MPSS_SYSROOT "${_SFBENCH_MPSS_ROOT}/sysroots/k1om-mpss-linux" CACHE PATH "Intel MPSS k1om sysroot")
if(EXISTS "${MPSS_SYSROOT}")
    set(CMAKE_FIND_ROOT_PATH "${MPSS_SYSROOT}")
    set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
    set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
endif()

set(CMAKE_C_FLAGS_INIT "-O3 -pthread")
set(CMAKE_CXX_FLAGS_INIT "-O3 -pthread")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-pthread")
